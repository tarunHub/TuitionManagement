# Copy to .env and fill in. Never commit .env.
LOGIN_MAX_FAILURES=5
MAIL_FROM=no-reply@smartstart.local
CHAT_MODEL=qwen3.5:latest
JOB_DISPATCH_CRON=0 * * * * *
JOB_DISPATCH_ENABLED=true
ADMIN_FULL_NAME=Administrator
SMS_GATEWAY_URL=
ADMIN_USERNAME=admin
GOOGLE_CALENDAR_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
GOOGLE_SEND_INVITES=false
DB_PORT=5432
JOB_FEE_REMINDER_CRON=0 0 9 5 * *
SMTP_USERNAME=
DB_PASSWORD=change-me
DB_USERNAME=portal
JOB_FEE_REMINDER_ENABLED=true
GOOGLE_APPLICATION_NAME=Smart Start Portal
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
LOGIN_LOCKOUT=15m
SMTP_PORT=1025

# Email: MailHog by default (http://localhost:8025). For Gmail use smtp.gmail.com / 587, SMTP_AUTH=true,
# SMTP_STARTTLS=true, your address as SMTP_USERNAME and MAIL_FROM, and a Gmail App Password as SMTP_PASSWORD.
SMTP_HOST=mailhog
SMS_GATEWAY_PASSWORD=
ADMIN_PASSWORD=change-me
SMS_GATEWAY_USERNAME=
SMTP_AUTH=false
SMTP_PASSWORD=
DB_NAME=student_portal
SPRING_PROFILES_ACTIVE=dev

# SMS via an Android phone running SMS Gateway (see RUNNING.md). Local: http://<phone-ip>:8080/message
SMS_ENABLED=false

# Ask assistant + feedback drafting via local Ollama (see RUNNING.md).
CHAT_ENABLED=true
SMS_DEFAULT_COUNTRY_CODE=1
JOB_CLASS_REMINDER_ENABLED=true
LOGGING_LEVEL_COM_SMARTSTART_PORTAL_CHAT=INFO
SMTP_STARTTLS=false
MAIL_FROM_NAME=Smart Start Tutoring
OLLAMA_URL=http://localhost:11434
